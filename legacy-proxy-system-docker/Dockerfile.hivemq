FROM hivemq/hivemq-ce:2025.5

COPY --chown=hivemq:hivemq hivemq/hivemq_broker/conf/config.xml /opt/hivemq/conf/config.xml
COPY --chown=hivemq:hivemq hivemq/hivemq_broker/extensions/retry-priority-extension /opt/hivemq/extensions/retry-priority-extension

EXPOSE 1883 8080

