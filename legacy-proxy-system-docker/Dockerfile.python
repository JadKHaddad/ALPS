FROM python:3.13-slim

COPY python/requirements.txt requirements.txt

RUN pip install --no-cache-dir -r requirements.txt

WORKDIR /app

COPY python/ars_comp_1_proxy.py ars_comp_1_proxy.py
COPY python/ars_comp_2_proxy.py ars_comp_2_proxy.py
COPY python/mqtt/legacy_proxy_1.py legacy_proxy_1.py
COPY python/mqtt/legacy_proxy_2.py legacy_proxy_2.py

